# name: test/sql/compaction/merge_adjacent_partition_values_of_table.test
# description: A compaction's file list reads the partition values of its own table only (duckdb/ducklake#1707, backported)
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/merge_adjacent_partition_values_of_table', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t (p INTEGER, v INTEGER);

statement ok
ALTER TABLE ducklake.t SET PARTITIONED BY (p);

statement ok
INSERT INTO ducklake.t VALUES (1, 1), (2, 2);

statement ok
INSERT INTO ducklake.t VALUES (1, 3), (2, 4);

# another partitioned table, whose partition values the merge of t must not read
statement ok
CREATE TABLE ducklake.other (p INTEGER, v INTEGER);

statement ok
ALTER TABLE ducklake.other SET PARTITIONED BY (p);

statement ok
INSERT INTO ducklake.other VALUES (7, 1);

statement ok
CALL enable_logging('DuckLakeMetadata')

# one row per merged group on 1.5: each partition merges its two files into one
query II
SELECT sum(files_processed), sum(files_created) FROM ducklake_merge_adjacent_files('ducklake', 't')
----
4	2

statement ok
CALL disable_logging()

# every compaction file list query filters the partition values by its table
query I
SELECT count(*) > 0 AND count(*) = count(*) FILTER (WHERE query LIKE '%ducklake_file_partition_value where table_id=%')
FROM (SELECT lower(regexp_replace(query, '\s+', ' ', 'g')) AS query FROM duckdb_logs_parsed('DuckLakeMetadata'))
WHERE query LIKE '%array_agg(partition_value%'
----
true

# each partition merged on its own
query II
SELECT p, list(v ORDER BY v) FROM ducklake.t GROUP BY p ORDER BY p
----
1	[1, 3]
2	[2, 4]

query I
SELECT count(*) FROM ducklake_list_files('ducklake', 't')
----
2
