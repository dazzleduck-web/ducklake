# name: test/sql/rowid/rowid_stats_pruning.test
# description: rowid predicates prune data files by their row id range - checked only through query results and files read, so this runs against every metadata catalog
# group: [rowid]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_rowid_pruning_files', DATA_INLINING_ROW_LIMIT 0)

# three files with row ids 0-99, 100-199, 200-299 and i = rowid
statement ok
CREATE TABLE ducklake.test(i INTEGER);

statement ok
INSERT INTO ducklake.test SELECT i FROM range(100) t(i)

statement ok
INSERT INTO ducklake.test SELECT i + 100 FROM range(100) t(i)

statement ok
INSERT INTO ducklake.test SELECT i + 200 FROM range(100) t(i)

query I
SELECT COUNT(*) FROM ducklake.test WHERE i <> rowid
----
0

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test WHERE rowid = 150
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test WHERE rowid < 100
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test WHERE rowid <= 100
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test WHERE rowid > 199
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test WHERE rowid >= 199
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test WHERE rowid BETWEEN 120 AND 180
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test WHERE rowid IN (5, 250)
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

query I
SELECT i FROM ducklake.test WHERE rowid IN (5, 150, 250, 1000) ORDER BY i
----
5
150
250

query I
SELECT COUNT(*) FROM ducklake.test WHERE rowid <> 150
----
299

query I
SELECT COUNT(*) FROM ducklake.test WHERE rowid IS NULL
----
0

# join on rowid: the build side's range is pushed into the scan at runtime
statement ok
CREATE TABLE lookup_keys AS SELECT 150::BIGINT AS k

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test JOIN lookup_keys ON ducklake.test.rowid = lookup_keys.k
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

statement ok
CREATE TABLE lookup_keys_multi AS SELECT * FROM (VALUES (3::BIGINT), (7::BIGINT), (299::BIGINT)) t(k)

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test JOIN lookup_keys_multi ON ducklake.test.rowid = lookup_keys_multi.k
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

query I
SELECT i FROM ducklake.test JOIN lookup_keys_multi ON ducklake.test.rowid = lookup_keys_multi.k ORDER BY i
----
3
7
299

# Top-N on rowid
query I
SELECT i FROM ducklake.test ORDER BY rowid DESC LIMIT 2
----
299
298

query I
SELECT i FROM ducklake.test ORDER BY rowid LIMIT 2
----
0
1

# time travel
query I
SELECT COUNT(*) FROM ducklake.test AT (VERSION => 2) WHERE rowid >= 100
----
0

# transaction-local data is not pruned through the catalog
statement ok
BEGIN

statement ok
INSERT INTO ducklake.test VALUES (1000)

query I
SELECT COUNT(*) FROM ducklake.test WHERE rowid >= 1000000000000000000
----
1

statement ok
ROLLBACK

# MERGE ... UPDATE preserves row ids: the rewritten file holds row ids 0-1 although it was assigned row_id_start 2
statement ok
CREATE TABLE ducklake.merged(i INTEGER, j INTEGER);

statement ok
INSERT INTO ducklake.merged VALUES (1, 5), (2, 5);

statement ok
MERGE INTO ducklake.merged USING (SELECT 1 AS i, 5 AS j) u ON ducklake.merged.j = u.j WHEN MATCHED THEN UPDATE;

query II
SELECT rowid, i FROM ducklake.merged WHERE rowid = 0
----
0	1

# the source row is copied into both matched rows - the row ids are kept
query II
SELECT rowid, i FROM ducklake.merged WHERE rowid >= 0 ORDER BY rowid
----
0	1
1	1

# UPDATE: the new file holds the preserved row ids
statement ok
CREATE TABLE ducklake.updated(i INTEGER);

statement ok
INSERT INTO ducklake.updated SELECT i FROM range(10) t(i)

statement ok
INSERT INTO ducklake.updated SELECT i + 10 FROM range(10) t(i)

statement ok
UPDATE ducklake.updated SET i = i + 100 WHERE rowid IN (3, 4)

query II
SELECT rowid, i FROM ducklake.updated WHERE rowid IN (3, 4, 15) ORDER BY rowid
----
3	103
4	104
15	15

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.updated WHERE rowid = 15
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

# inlining: small inserts are inlined and always scanned, a large one goes straight to a file
statement ok
CREATE TABLE ducklake.mixed(i INTEGER);

statement ok
CALL ducklake.set_option('data_inlining_row_limit', 10, table_name => 'mixed')

statement ok
INSERT INTO ducklake.mixed SELECT i FROM range(5) t(i)

statement ok
INSERT INTO ducklake.mixed SELECT i + 5 FROM range(100) t(i)

statement ok
INSERT INTO ducklake.mixed SELECT i + 105 FROM range(4) t(i)

query I
SELECT i FROM ducklake.mixed WHERE rowid IN (2, 50, 106) ORDER BY i
----
2
50
106

# the flushed file holds row ids 0-4 and 105-108
statement ok
CALL ducklake_flush_inlined_data('ducklake', table_name => 'mixed')

query I
SELECT i FROM ducklake.mixed WHERE rowid IN (2, 50, 106, 107) ORDER BY i
----
2
50
106
107

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.mixed WHERE rowid = 107
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

# the flushed file's range 0-108 spans the gap, so it overlaps the file holding row ids 5-104
query II
EXPLAIN ANALYZE SELECT * FROM ducklake.mixed WHERE rowid = 50
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

# partitioned insert: one file per partition
statement ok
CREATE TABLE ducklake.partitioned(i INTEGER, p INTEGER);

statement ok
ALTER TABLE ducklake.partitioned SET PARTITIONED BY (p);

statement ok
INSERT INTO ducklake.partitioned SELECT i, i // 10 FROM range(30) t(i)

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.partitioned WHERE rowid = 25
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query I
SELECT i FROM ducklake.partitioned WHERE rowid IN (0, 15, 29) ORDER BY i
----
0
15
29

# merge_adjacent_files over adjacent files
statement ok
CREATE TABLE ducklake.compacted(i INTEGER);

statement ok
INSERT INTO ducklake.compacted SELECT i FROM range(10) t(i)

statement ok
INSERT INTO ducklake.compacted SELECT i + 10 FROM range(10) t(i)

statement ok
INSERT INTO ducklake.compacted SELECT i + 20 FROM range(10) t(i)

statement ok
CALL ducklake_merge_adjacent_files('ducklake', 'compacted')

statement ok
INSERT INTO ducklake.compacted SELECT i + 30 FROM range(10) t(i)

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.compacted WHERE rowid = 35
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query I
SELECT COUNT(*) FROM ducklake.compacted WHERE i <> rowid
----
0

# merge_adjacent_files keeps the row ids an UPDATE preserved
statement ok
CREATE TABLE ducklake.merge_updated(i INTEGER);

statement ok
INSERT INTO ducklake.merge_updated SELECT i FROM range(10) t(i)

statement ok
INSERT INTO ducklake.merge_updated SELECT i + 10 FROM range(10) t(i)

statement ok
UPDATE ducklake.merge_updated SET i = i + 100 WHERE rowid < 3

statement ok
CREATE TABLE merge_updated_before AS SELECT rowid AS r, i FROM ducklake.merge_updated

statement ok
CALL ducklake_merge_adjacent_files('ducklake', 'merge_updated')

query I
SELECT COUNT(*) FROM merge_updated_before b FULL OUTER JOIN (SELECT rowid AS r, i FROM ducklake.merge_updated) a USING (r)
WHERE b.i IS DISTINCT FROM a.i
----
0

query II
SELECT rowid, i FROM ducklake.merge_updated WHERE rowid IN (0, 2, 15) ORDER BY rowid
----
0	100
2	102
15	15

# merge_adjacent_files on a sorted table re-sorts rows, so it keeps their row ids
statement ok
CREATE TABLE ducklake.merge_sorted(i INTEGER);

statement ok
ALTER TABLE ducklake.merge_sorted SET SORTED BY (i DESC);

statement ok
INSERT INTO ducklake.merge_sorted SELECT i FROM range(5) t(i)

statement ok
INSERT INTO ducklake.merge_sorted SELECT i + 5 FROM range(5) t(i)

statement ok
CREATE TABLE merge_sorted_before AS SELECT rowid AS r, i FROM ducklake.merge_sorted

statement ok
CALL ducklake_merge_adjacent_files('ducklake', 'merge_sorted')

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'merge_sorted')
----
1

query I
SELECT COUNT(*) FROM merge_sorted_before b FULL OUTER JOIN (SELECT rowid AS r, i FROM ducklake.merge_sorted) a USING (r)
WHERE b.i IS DISTINCT FROM a.i
----
0

# rewrite_data_files
statement ok
CREATE TABLE ducklake.rewritten(i INTEGER);

statement ok
INSERT INTO ducklake.rewritten SELECT i FROM range(20) t(i)

statement ok
DELETE FROM ducklake.rewritten WHERE i < 15

statement ok
CALL ducklake_rewrite_data_files('ducklake', 'rewritten', delete_threshold => 0)

statement ok
INSERT INTO ducklake.rewritten SELECT i + 20 FROM range(10) t(i)

query I
SELECT i FROM ducklake.rewritten WHERE rowid IN (17, 25) ORDER BY i
----
17
25

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.rewritten WHERE rowid = 17
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

# ducklake_add_data_files
statement ok
COPY (SELECT (i + 3)::INTEGER AS i FROM range(7) t(i)) TO '${DATA_PATH}/ducklake_rowid_pruning_added.parquet'

statement ok
CREATE TABLE ducklake.added(i INTEGER);

statement ok
INSERT INTO ducklake.added SELECT i FROM range(3) t(i)

statement ok
CALL ducklake_add_data_files('ducklake', 'added', '${DATA_PATH}/ducklake_rowid_pruning_added.parquet')

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.added WHERE rowid = 8
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query I
SELECT COUNT(*) FROM ducklake.added WHERE i <> rowid
----
0
